// RENAME THIS FILE TO .env.local TO USE THESE VARIABLES PROPERLY

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://kumoritv.vercel.app
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Prompt 38B: the community (feed, post pages, announcement pages, the
# /api/community routes and the footer link). Read at request time.
# Leave empty (or 0) and the feature is off: /community* and the APIs 404,
# the footer has no Community link and the bell keeps its old behaviour.
COMMUNITY_ENABLED=

# Web push (OneSignal). The client key is public; the REST key is server only.
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXT_PUBLIC_SITE_URL=https://kumoritv.vercel.app
SHIKIMORI_BASE_URL=https://shikimori.io
ANIVEXA_BASE_URL=https://anivexa.otakunaija.name.ng

# Title logos (optional). A v3 API key OR a v4 read access token turns on the
# TMDB logo sync (/api/cron/logos) and the "logo instead of text title" heading.
# Leave both empty and the site simply renders text titles - nothing breaks.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Required for signed stream proxy URLs
PROXY_SIGNING_SECRET=
# Set to node (or true/1) when segment streaming needs the Node runtime
PROXY_SEGMENT_RUNTIME=node

NEXT_PUBLIC_ANILIST_API_URL=https://graphql.anilist.co/

// BACKEND SERVER URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:1234

// Anilist OAuth Settings
NEXT_PUBLIC_ANILIST_CLIENT_ID=your-anilist-client-id
ANILIST_CLIENT_SECRET=your-anilist-client-secret

// This is the URL to use ONLY on DEV Enviroment. You WILL NEED TO CHANGE IT when hosting it to its respective url.
// Its used on Next.js API Calls
NEXT_PUBLIC_WEBSITE_ORIGIN_URL=http://localhost:3000

// Firebase Settings
NEXT_PUBLIC_FIREBASE_API_KEY=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_PROJECT_ID=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_APP_ID=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_DATABASE_URL=firebase-setting-related-to-this-field

// GOOGLE ANALYTICS: optional
NEXT_PUBLIC_MEASUREMENT_ID=your-measurement-id
