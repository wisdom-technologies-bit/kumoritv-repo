// RENAME THIS FILE TO .env.local TO USE THESE VARIABLES PROPERLY

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://kumoritv.vercel.app
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Prompt 38B: the community (feed, post pages, announcement pages, the
# /api/community routes and the footer link). Read at request time.
# Leave empty (or 0) and the feature is off: /community* and the APIs 404,
# the footer has no Community link and the bell keeps its old behaviour.
COMMUNITY_ENABLED=

# Phase 4: the new-post bar and announcements. ALL OPTIONAL - the defaults below
# are what the code uses when these are unset, so nothing has to be added to a
# deploy. They exist so the owner can tune the bar without a code change.
#
# COMMUNITY_POLL_SECONDS      how often the bar asks /api/community/latest
#                             (default 30, floor 5). The server cache is 10 s, so
#                             polling faster than that only costs requests.
# COMMUNITY_TOAST_SECONDS     how long a toast stays visible (default 5).
# COMMUNITY_TOAST_MIN_GAP_SECONDS  minimum gap between two toasts (default 10);
#                             anything newer than the shown toast is collapsed
#                             into the next one.
#
# To turn the bar off for EVERYONE while leaving the community itself on, set
# COMMUNITY_TOASTS=off (or 0/false/no). Per-user control is the "New post
# notifications" switch in Settings -> Notifications (profiles.community_toasts),
# which defaults to on.
COMMUNITY_TOASTS=
COMMUNITY_POLL_SECONDS=30
COMMUNITY_TOAST_SECONDS=5
COMMUNITY_TOAST_MIN_GAP_SECONDS=10

# Phase 5: the public clip browse at /clips and GET /api/clips. Read at request
# time, so a Railway variable change needs no rebuild. Leave empty (or 0) and
# /clips stays exactly what it was before Phase 5 - "My clips" for a signed-in
# viewer, the sign-in prompt for a guest - and GET /api/clips answers 404. The
# sitemap entry for /clips is added only while this flag is on.
CLIPS_PUBLIC_ENABLED=

# Guest clip ownership: the raw cookie token is never stored, only its HMAC.
# Changing this invalidates every existing guest's "my clips" list (their clips
# stay public, they just stop being deletable by that browser).
CLIP_OWNER_SECRET=

# Web push (OneSignal). The client key is public; the REST key is server only.
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXT_PUBLIC_SITE_URL=https://kumoritv.vercel.app
SHIKIMORI_BASE_URL=https://shikimori.io
ANIVEXA_BASE_URL=https://anivexa.otakunaija.name.ng

# Title logos (optional). A v3 API key OR a v4 read access token turns on the
# TMDB logo sync (/api/cron/logos) and the "logo instead of text title" heading.
# Leave both empty and the site simply renders text titles - nothing breaks.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Advertising - Adcash Autotag (docs/ads-adcash.md). The one ad tag on the site
# since 2026-11-15. Nothing renders while ADCASH_ENABLED is 0/empty.
ADCASH_ENABLED=0
# Autotag zone generated for https://kumoritv.top. Empty falls back to it.
ADCASH_ZONE_ID=wdslld7xas
# Comma list of path prefixes that never load the tag.
ADCASH_EXCLUDE_PATHS=/admin,/api,/community-off,/notifications/welcome

# Episode downloads (docs/ani-provider.md, docs/ads-adcash.md).
DOWNLOADS_ENABLED=
DOWNLOAD_HOSTS=
# Sponsor page opened from the download click. LEAVE THIS EMPTY until you have
# an Adcash direct-link or popunder URL. Do not reuse the retired provider's
# link after the switch - it belonged to that account (the removal log in
# docs/ads-adcash.md lists what was removed and why).
DOWNLOAD_AD_URL=
# Minutes between sponsor opens (0 = every click). Empty keeps the 30 default.
DOWNLOAD_AD_INTERVAL_MIN=

# Required for signed stream proxy URLs
PROXY_SIGNING_SECRET=
# Set to node (or true/1) when segment streaming needs the Node runtime
PROXY_SEGMENT_RUNTIME=node

NEXT_PUBLIC_ANILIST_API_URL=https://graphql.anilist.co/

// BACKEND SERVER URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:1234

// Anilist OAuth Settings
NEXT_PUBLIC_ANILIST_CLIENT_ID=your-anilist-client-id
ANILIST_CLIENT_SECRET=your-anilist-client-secret

// This is the URL to use ONLY on DEV Enviroment. You WILL NEED TO CHANGE IT when hosting it to its respective url.
// Its used on Next.js API Calls
NEXT_PUBLIC_WEBSITE_ORIGIN_URL=http://localhost:3000

// Firebase Settings
NEXT_PUBLIC_FIREBASE_API_KEY=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_PROJECT_ID=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_APP_ID=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=firebase-setting-related-to-this-field
NEXT_PUBLIC_FIREBASE_DATABASE_URL=firebase-setting-related-to-this-field

// GOOGLE ANALYTICS: optional
NEXT_PUBLIC_MEASUREMENT_ID=your-measurement-id

# Prompt 40: Adcash IN-STREAM (pre-roll) on the watch page. Everything is off
# until BOTH PREROLL_ENABLED=1 and ADCASH_VAST_URL are set - the VAST tag is
# configuration, not a secret, but it is never hard-coded in the repo.
# docs/ads-adcash.md has the dashboard steps and the failure rules.
PREROLL_ENABLED=0
# The zone's VAST Tag URL from the Adcash panel (In-stream Video zone).
ADCASH_VAST_URL=
# At most one pre-roll per viewer per N minutes. 0 = every eligible play.
PREROLL_INTERVAL_MIN=20
# Skip appears after this many seconds ONLY when the VAST has no skipoffset. Max 10.
PREROLL_SKIP_AFTER_SEC=5
# An ad longer than this is treated as "no ad".
PREROLL_MAX_AD_SEC=30
# Creative must start within this budget, else the content plays.
PREROLL_START_TIMEOUT_MS=5000
# VAST document fetch budget (fallback engine).
PREROLL_VAST_TIMEOUT_MS=3000
# After a no-fill (Adcash answering an empty <VAST/>), stop asking for this many
# minutes so nobody pays the wait on every episode. 0 disables the cooldown.
PREROLL_NOFILL_COOLDOWN_MIN=10

# ─── Adult provider (watchhentai) ────────────────────────────────────────────
# Off unless this is 1. When it is off, /api/adult/variants answers
# providerEnabled:false and the watch route never enters the adult branch.
ADULT_PROVIDER_ENABLED=0
# Base URL of the deployed watchhentai service, no trailing slash.
WATCHHENTAI_API_URL=https://adult.kumoritv.top
# The same key set on that service as API_KEY. Server-side only: never a
# NEXT_PUBLIC_ variable, never logged.
WATCHHENTAI_API_KEY=
# Preferred source label ("1080p" falls back to whatever the source lists).
ADULT_PREFERRED_QUALITY=1080p
# Title-match floor and fan-out for episodes nobody has mapped yet. 0.7 accepts
# an exact title and near misses above it; a lower floor maps more and risks
# matching the wrong show. Set ADULT_MATCH_MIN_SCORE=1 to require an exact title.
ADULT_MATCH_MIN_SCORE=0.7
ADULT_MATCH_MAX_CANDIDATES=4
# How long a resolved upstream URL is reused (clamped to 3600).
ADULT_CACHE_TTL_SECONDS=900
